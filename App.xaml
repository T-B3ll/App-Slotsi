<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:slotsi_citas.Services"
             x:Class="slotsi_citas.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Estilo global para Border -->
            <Style TargetType="Border">
                <Setter Property="InputTransparent" Value="False" />
                <Style.Behaviors>
                    <services:TouchEffectBehavior />
                </Style.Behaviors>
            </Style>

            <!-- Estilo global para Button -->
            <Style TargetType="Button">
                <Style.Behaviors>
                    <services:TouchEffectBehavior />
                </Style.Behaviors>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>