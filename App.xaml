<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:slotsi_citas.Converters"
             x:Class="slotsi_citas.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters para Cita_Usuario -->
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <!-- Colores globalizados -->
            <Color x:Key="PrimaryColor">#2563EB</Color>
            <Color x:Key="SecondaryColor">#F97316</Color>
            <Color x:Key="BackgroundColor">#F5F5F5</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="OccupiedColor">#FFFBEB</Color>
            <Color x:Key="UnavailableColor">#F3F4F6</Color>

            <!-- Estilos reutilizables -->
            <Style x:Key="ButtonAgendarCita" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="BorderWidth" Value="1.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>