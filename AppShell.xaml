<?xml version="1.0" encoding="UTF-8" ?>
<Shell BackgroundColor="#2563EB" FlyoutBackgroundColor="White" FlyoutBehavior="Flyout" Title="Slotsi" x:Class="slotsi_citas.AppShell" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:pages="clr-namespace:slotsi_citas.Pages" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ENCABEZADO DEL MENÚ LATERAL -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#2563EB" HeightRequest="150" Padding="20">
            <VerticalStackLayout Spacing="6" VerticalOptions="End">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border BackgroundColor="#3B82F6" HeightRequest="44" Stroke="Transparent" StrokeShape="RoundRectangle 22" WidthRequest="44">
                        <Label FontSize="20" HorizontalOptions="Center" Text="✂️" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="20" Text="Slotsi Citas" TextColor="White"/>
                        <Label FontSize="12" Text="Gestión de Barbería" TextColor="#DBEAFE"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ÍTEMS DE NAVEGACIÓN -->
    <FlyoutItem Route="LoginPage" Title="Trabajos a Domicilio">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE88A;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:LoginPage}"/>
    </FlyoutItem>

    <FlyoutItem Route="Cita_ClientePage" Title="Citas Cliente">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xEBCC;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:Cita_ClientePage}"/>
    </FlyoutItem>

    <FlyoutItem Route="Cita_UsuarioPage" Title="Citas Barbero">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE7FD;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:Cita_UsuarioPage}"/>
    </FlyoutItem>

    <FlyoutItem Route="cataloservicios" Title="Catálogo de Servicios">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE8EF;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:catalogoservicios}"/>
    </FlyoutItem>

    <FlyoutItem Route="catalogocliente" Title="Catálogo de Clientes">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE7EF;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:CatalogoCliente}"/>
    </FlyoutItem>

    <FlyoutItem Route="RegistroUsuariosPage" Title="Registro de Usuarios">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE7FE;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:RegistroUsuariosPage}"/>
    </FlyoutItem>

    <FlyoutItem Route="CalendarioPage" Title="Calendario">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE916;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:CalendarioPage}"/>
    </FlyoutItem>

    <FlyoutItem Route="SeleccionarCitaPage" Title="Seleccionar Cita">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE8B5;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:SeleccionarCitaPage}"/>
    </FlyoutItem>

    <FlyoutItem Route="ListaTrabajadores" Title="Trabajadores">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE7FB;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:ListaTrabajadores}"/>
    </FlyoutItem>

    <FlyoutItem Route="Calificaciones" Title="Calificaciones">
        <FlyoutItem.Icon>
            <FontImageSource Color="#2563EB" FontFamily="MaterialIcons" Glyph="&#xE838;" Size="22"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate pages:CentroCalificaciones}"/>
    </FlyoutItem>


    <Shell.FlyoutFooter>
        <Border BackgroundColor="#FEF2F2" Margin="16,10,16,20" Padding="12" Stroke="#FEE2E2" StrokeShape="RoundRectangle 10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarSesionClicked"/>
            </Border.GestureRecognizers>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Image Source="{FontImageSource FontFamily=MaterialIcons, Glyph='&#xE8AC;', Color=#DC2626, Size=22}"/>
                <Label FontAttributes="Bold" FontSize="14" Text="Cerrar Sesión" TextColor="#DC2626" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </Shell.FlyoutFooter>

</Shell>