<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="slotsi_citas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:slotsi_citas.Pages"
    Title="Slotsi">

    <TabBar>
        <!-- Pestaña 1: Registro de Usuario (AHORA ES LA PRIMERA) -->
        <Tab Title="Registro" Icon="profile.png">
            <ShellContent
                Title="Registro de Usuario"
                ContentTemplate="{DataTemplate pages:RegistroUsuariosPage}"
                Route="RegistroUsuariosPage" />
        </Tab>

        <!-- Pestaña 2: Vista Cliente (Login primero) -->
        <Tab Title="Vista Cliente" Icon="calendar.png">
            <ShellContent
                Title="Iniciar Sesión"
                ContentTemplate="{DataTemplate pages:LoginPage}"
                Route="LoginPage" />
        </Tab>

        <!-- Pestaña 3: Vista Barbero -->
        <Tab Title="Vista Barbero" Icon="profile.png">
            <ShellContent
                Title="Citas Barbero"
                ContentTemplate="{DataTemplate pages:Cita_UsuarioPage}"
                Route="Cita_UsuarioPage" />
        </Tab>

        <!-- Pestaña 4: Catalogo de servicios -->
        <Tab Title="Catalogo de servicios" Icon="profile.png">
            <ShellContent
                Title="Servicios disponibles"
                ContentTemplate="{DataTemplate pages:catalogoservicios}"
                Route="cataloservicios" />
        </Tab>

        <!-- Pestaña 5: Catalogo de cliente -->
        <Tab Title="Catalogo de cliente" Icon="profile.png">
            <ShellContent
                Title="Clientes"
                ContentTemplate="{DataTemplate pages:CatalogoCliente}"
                Route="catalogocliente" />
        </Tab>

        <!-- Pestaña 6: Calendario Citas -->
        <Tab Title="Calendario" Icon="calendar.png">
            <ShellContent
                Title="Calendario"
                ContentTemplate="{DataTemplate pages:CalendarioPage}"
                Route="CalendarioPage" />
        </Tab>
    </TabBar>

</Shell>