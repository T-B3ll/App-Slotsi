<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.ReporteTopServiciosPage"
             Title="Top Servicios"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" BackgroundColor="#2563EB" Padding="16, 14">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" 
                       Text="&#xE5C4;" 
                       FontFamily="MaterialIcons" 
                       FontSize="26" 
                       TextColor="White" 
                       VerticalOptions="Center"
                       Margin="0,0,10,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" 
                       Text="Top Servicios" 
                       FontSize="19" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="20">

                <Border StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#E0E7FF" 
                        StrokeThickness="0" 
                        Padding="4"
                        HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="0">
                        <Button x:Name="BtnSemana"
                                Text="Semana" 
                                FontSize="13" 
                                FontAttributes="Bold" 
                                CornerRadius="16" 
                                HeightRequest="36" 
                                Padding="16,0"
                                BackgroundColor="#2563EB" 
                                TextColor="White"
                                Clicked="OnSemanaClicked"/>
                        <Button x:Name="BtnMes"
                                Text="Mes" 
                                FontSize="13" 
                                CornerRadius="16" 
                                HeightRequest="36" 
                                Padding="16,0"
                                BackgroundColor="Transparent" 
                                TextColor="#4B5563"
                                Clicked="OnMesClicked"/>
                    </HorizontalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,10">
                    <Button Text="PDF" 
                            BackgroundColor="#EF4444" 
                            TextColor="White" 
                            CornerRadius="8" 
                            HeightRequest="40" 
                            WidthRequest="100"
                            Clicked="OnGenerarPdfClicked"/>
                    <Button Text="Excel" 
                            BackgroundColor="#10B981" 
                            TextColor="White" 
                            CornerRadius="8" 
                            HeightRequest="40" 
                            WidthRequest="100"
                            Clicked="OnGenerarExcelClicked"/>
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="12" x:Name="TopServiciosContainer">
                    <Label Text="Cargando reporte..." TextColor="#6B7280" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 12" 
                        BackgroundColor="White" 
                        Stroke="#E5E7EB" 
                        StrokeThickness="1" 
                        Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto, Auto" 
                              BackgroundColor="#F8FAFC" 
                              Padding="16,12">
                            <Label Grid.Column="0" Text="Servicio" FontSize="12" FontAttributes="Bold" TextColor="#6B7280"/>
                            <Label Grid.Column="1" Text="Citas" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" HorizontalOptions="End" Margin="0,0,10,0"/>
                            <Label Grid.Column="2" Text="Duración" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" HorizontalOptions="End" WidthRequest="70"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#E5E7EB"/>

                        <VerticalStackLayout x:Name="TablaServiciosContainer" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>