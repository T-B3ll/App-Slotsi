<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.NuevoTrabajador"
             Title="Nuevo Trabajador"
             BackgroundColor="#F8FAFC">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,10">
                <Grid WidthRequest="90" HeightRequest="90">
                    <Ellipse Fill="#EEF2FF" Stroke="#6366F1" StrokeThickness="1" />

                    <Border WidthRequest="90" 
                            HeightRequest="90" 
                            StrokeShape="RoundRectangle 45" 
                            StrokeThickness="0" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Center">
                        <Image Source="{Binding FotoPrevisualizacion, FallbackValue='profile_picture.png'}" 
                               Aspect="AspectFill" />
                    </Border>

                    <ImageButton Source="icon_camera.png" 
                                 CornerRadius="18" 
                                 WidthRequest="36" 
                                 HeightRequest="36" 
                                 BackgroundColor="#2563EB" 
                                 HorizontalOptions="End" 
                                 VerticalOptions="End" 
                                 Command="{Binding SeleccionarFotoCommand}" />
                </Grid>
                <Label Text="Subir foto de perfil" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Nombre" TextColor="#1E293B" FontAttributes="Bold" />
                    <Label Text="*" TextColor="#EF4444" />
                </HorizontalStackLayout>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="12,0" BackgroundColor="#F8FAFC">
                    <Entry Placeholder="Ej. Carlos" Text="{Binding Nombre}" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Apellido" TextColor="#1E293B" FontAttributes="Bold" />
                    <Label Text="*" TextColor="#EF4444" />
                </HorizontalStackLayout>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="12,0" BackgroundColor="#F8FAFC">
                    <Entry Placeholder="Ej. Rodríguez" Text="{Binding Apellido}" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Número telefónico" TextColor="#1E293B" FontAttributes="Bold" />
                    <Label Text="*" TextColor="#EF4444" />
                </HorizontalStackLayout>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="12,0" BackgroundColor="#F8FAFC">
                    <Entry Placeholder="Ej. +505-8989-9090" Keyboard="Telephone" Text="{Binding Telefono}" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Correo electrónico" TextColor="#1E293B" FontAttributes="Bold" />
                    <Label Text="*" TextColor="#EF4444" />
                </HorizontalStackLayout>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="12,0" BackgroundColor="#F8FAFC">
                    <Entry Placeholder="Ej. carlos.rod@gmail.com" Keyboard="Email" Text="{Binding Correo}" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Número de cédula" TextColor="#1E293B" FontAttributes="Bold" />
                    <Label Text="*" TextColor="#EF4444" />
                </HorizontalStackLayout>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="12,0" BackgroundColor="#F8FAFC">
                    <Entry Placeholder="Ej. 212-232123-2002Q" Text="{Binding Cedula}" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Título o Certificado Profesional" TextColor="#1E293B" FontAttributes="Bold" />
                    <Label Text="*" TextColor="#EF4444" />
                </HorizontalStackLayout>
                <Border Stroke="#3B82F6" StrokeDashArray="4,2" StrokeThickness="1.5" StrokeShape="RoundRectangle 8" Padding="20" BackgroundColor="#F0F9FF">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Image Source="icon_upload_cloud.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                        <Label Text="{Binding NombreDocumento, FallbackValue='Subir documento del título profesional'}" FontSize="13" TextColor="#2563EB" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SubirDocumentoCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

            <Button Text="Guardar Trabajador" 
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0,12,0,20"
                    Command="{Binding GuardarTrabajadorCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>