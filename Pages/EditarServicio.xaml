<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:behaviors="clr-namespace:slotsi_citas.Pages"
             x:Class="slotsi_citas.Pages.EditarServicio"
             Title="Editar Servicio"
             BackgroundColor="#F9FAFB"
             android:Application.WindowSoftInputModeAdjust="Resize">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16" Margin="0,0,0,30">

            <Label Text="{Binding TituloPantalla}" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
            <Label Text="Los campos maracados con un *, son obligatorios" FontSize="10" TextColor="#EF4444" FontAttributes="Bold"/>

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                    
                    <Label Text="Foto del servicio" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                </HorizontalStackLayout>
                <Border WidthRequest="110" HeightRequest="110" Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#E5E7EB">
                    <Image Source="{Binding Foto}" Aspect="AspectFill"/>
                </Border>

                <Button Text="Seleccionar Foto"
                        Command="{Binding CambiarFotoCommand}"
                        BackgroundColor="#E5E7EB"
                        TextColor="#374151"
                        CornerRadius="8"
                        HeightRequest="36"
                        FontSize="12"/>
            </VerticalStackLayout>


            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Nombre del Servicio" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                </HorizontalStackLayout>
                <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10,0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 8">
                    <Entry Text="{Binding Nombre}"
                           TextColor="#1E293B"
                           Placeholder="Ej. Corte Clásico"
                           PlaceholderColor="#9CA3AF"
                           Keyboard="Text"
                           MaxLength="60"
                           HeightRequest="45">
                        <Entry.Behaviors>
                            <behaviors:FiltroEntryBehavior Tipo="SoloLetras" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <HorizontalStackLayout Spacing="2">
                        <Label Text="Precio ($)" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                        <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10,0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 8">
                        <Entry Text="{Binding PrecioTexto}"
                               TextColor="#1E293B"
                               Placeholder="Ej. 150"
                               PlaceholderColor="#9CA3AF"
                               Keyboard="Numeric"
                               MaxLength="9"
                               HeightRequest="45">
                            <Entry.Behaviors>
                                <behaviors:FiltroEntryBehavior Tipo="SoloDecimales" />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <HorizontalStackLayout Spacing="2">
                        <Label Text="Duración (min)" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                        <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10,0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 8">
                        <Entry Text="{Binding DuracionTexto}"
                               TextColor="#1E293B"
                               Placeholder="Ej. 30"
                               PlaceholderColor="#9CA3AF"
                               Keyboard="Numeric"
                               MaxLength="4"
                               HeightRequest="45">
                            <Entry.Behaviors>
                                <behaviors:FiltroEntryBehavior Tipo="SoloEnteros" />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Categoría" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                </HorizontalStackLayout>
                <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10,0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 8">
                    <Entry Text="{Binding Categoria}"
                           TextColor="#1E293B"
                           Placeholder="Ej. Barbería"
                           PlaceholderColor="#9CA3AF"
                           Keyboard="Text"
                           MaxLength="40"
                           HeightRequest="45">
                        <Entry.Behaviors>
                            <behaviors:FiltroEntryBehavior Tipo="SoloLetras" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Descripción" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                </HorizontalStackLayout>
                <Border Stroke="#D1D5DB" StrokeThickness="1" Padding="10,4" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 8">
                    <Editor Text="{Binding Descripcion}"
                            TextColor="#1E293B"
                            Placeholder="Ej. Corte con máquina y tijera, incluye lavado"
                            PlaceholderColor="#9CA3AF"
                            MaxLength="250"
                            HeightRequest="90"
                            AutoSize="Disabled"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6" Margin="0,5">
                <HorizontalStackLayout Spacing="2">
                    <Label Text="Colaboradores Habilitados" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Label Text="*" FontSize="13" TextColor="#EF4444" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <CollectionView ItemsSource="{Binding Colaboradores}" HeightRequest="160">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#E5E7EB" StrokeThickness="1" Padding="10,6" Margin="0,0,0,8" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding Nombre}" VerticalOptions="Center" TextColor="#1F2937" FontSize="14"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSeleccionado}" Color="#2563EB"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No se encontraron colaboradores registrados." TextColor="#9CA3AF" FontSize="12" HorizontalOptions="Center" Margin="0,10"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                <Label Grid.Column="0" Text="Disponible a domicilio" FontSize="14" TextColor="#374151" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="{Binding DisponibleDomicilio}" OnColor="#2563EB"/>
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,15,0,20">
                <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelarCommand}" BackgroundColor="#E5E7EB" TextColor="#374151" CornerRadius="8" HeightRequest="45"/>
                <Button Grid.Column="1" Text="{Binding TextoBotonGuardar}" Command="{Binding GuardarCommand}" BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
