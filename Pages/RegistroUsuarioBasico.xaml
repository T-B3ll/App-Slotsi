<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:slotsi_citas.ViewModel"
             xmlns:converters="clr-namespace:slotsi_citas.Converters"
             x:Class="slotsi_citas.Pages.RegistroUsuarioBasico"
             Title="Crear Cuenta"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Button Text="← Atrás" 
                    BackgroundColor="Transparent" 
                    TextColor="#2563EB" 
                    FontSize="17"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,20,0,-10"
                    Clicked="OnBackClicked"/>

  
            <Label Text="Crear Cuenta" FontSize="32" FontAttributes="Bold" TextColor="#2563EB" />
            <Label Text="Usuario Básico" FontSize="16" TextColor="#6B7280" Margin="0,-5,0,0"/>
            <Label Text="Los campos que tengan un &quot;*&quot; son obligatorios" FontSize="13" TextColor="#6B7280" Margin="0,15,0,5"/>


            <Label Text="Nombre completo *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Frame BackgroundColor="#F3F4F6" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
              
                <Entry Placeholder="Juan Pérez" 
                       PlaceholderColor="#9CA3AF" 
                       TextColor="#111827" 
                       FontSize="16" 
                       BackgroundColor="Transparent" 
                       VerticalOptions="Center"
                       Text="{Binding NombreCompleto}"/>
            </Frame>

            <Label Text="Correo electrónico *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Frame BackgroundColor="#F3F4F6" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
                <Entry Placeholder="juan@ejemplo.com" 
                       Keyboard="Email" 
                       PlaceholderColor="#9CA3AF" 
                       TextColor="#111827" 
                       FontSize="16" 
                       BackgroundColor="Transparent" 
                       VerticalOptions="Center"
                       Text="{Binding Correo}"/>
            </Frame>


            <Label Text="Teléfono *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Frame BackgroundColor="#F3F4F6" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
                <Entry Placeholder="+505 8888-8888" 
                       Keyboard="Telephone" 
                       PlaceholderColor="#9CA3AF" 
                       TextColor="#111827" 
                       FontSize="16" 
                       BackgroundColor="Transparent" 
                       VerticalOptions="Center"
                       Text="{Binding Telefono}"/>
            </Frame>


            <Label Text="Cédula *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Frame BackgroundColor="#F3F4F6" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
                <Entry Placeholder="0000-0000-0000J" 
                       Keyboard="Text" 
                       PlaceholderColor="#9CA3AF" 
                       TextColor="#111827" 
                       FontSize="16" 
                       BackgroundColor="Transparent" 
                       VerticalOptions="Center"
                       Text="{Binding Cedula}"/>
            </Frame>

            <Label Text="Establecer contraseña *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Frame BackgroundColor="#F3F4F6" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry"     
                           Grid.Column="0"
                           Placeholder="••••••••" 
                           IsPassword="True"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           FontSize="16"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           Text="{Binding Contrasena}"/>

            
                    <ImageButton x:Name="BtnTogglePassword"
                                 Grid.Column="1"
                                 Source="eye_open.png"
                                 WidthRequest="24"
                                 HeightRequest="24"
                                 Aspect="AspectFit"
                                 BackgroundColor="Transparent"
                                 VerticalOptions="Center"
                                 Clicked="OnTogglePasswordVisibility"
                                 Margin="0,0,8,0"/>
                </Grid>
            </Frame>


            <BoxView HeightRequest="30" Color="Transparent"/>
            <Button Text="Registrarse" 
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="58"
                    CornerRadius="14"
                    Margin="0,0,0,20"
                    Command="{Binding RegistrarCommand}"
                    IsEnabled="{Binding EstaCargando, Converter={StaticResource InverseBoolConverter}}"/>


            <ActivityIndicator IsRunning="{Binding EstaCargando}" 
                               IsVisible="{Binding EstaCargando}"
                               Color="#2563EB" 
                               Margin="0,-10,0,20"/>
            
            
            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>