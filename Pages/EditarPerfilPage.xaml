<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             x:Class="slotsi_citas.Pages.EditarPerfilPage"
             Title="{Binding TituloPagina}"
             BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

       
            <Label Text="Editar Información de Perfil" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
            <Label Text="Actualiza tus datos personales y de negocio" FontSize="14" TextColor="#6B7280" Margin="0,-5,0,10"/>

        
            <Border StrokeShape="RoundRectangle 14" 
                    Stroke="#E5E7EB" 
                    BackgroundColor="#FAFBFC" 
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos Personales" FontSize="17" FontAttributes="Bold" TextColor="#111827"/>

                  
                    <Label Text="Nombre completo *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="EntryNombre"
                           Text="{Binding Usuario.NombreCompleto}" 
                           Placeholder="Tu nombre completo" 
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           IsEnabled="{Binding PuedeEditar}"
                           BackgroundColor="#F9FAFB" HeightRequest="50"/>   

               
                    <Label Text="Correo electrónico *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Usuario.Correo}" 
                           IsReadOnly="True" 
                           Opacity="0.6"
                           TextColor="#6B7280"
                           BackgroundColor="#E5E7EB" 
                           HeightRequest="50"/>
                          

                    
                    <Label Text="Teléfono *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="EntryTelefono" 
                           Keyboard="Telephone"
                           Placeholder="+505 0000-0000"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           IsEnabled="{Binding PuedeEditar}"
                           BackgroundColor="#F9FAFB" 
                           HeightRequest="50"
                           TextChanged="OnTelefonoChanged"/>

                   
                    <Label Text="Cédula / ID *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry x:Name="EntryCedula" 
                           Keyboard="Text"
                           Placeholder="000-000000-0000A"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           IsEnabled="{Binding PuedeEditar}"
                           BackgroundColor="#F9FAFB" 
                           HeightRequest="50"
                           TextChanged="OnCedulaChanged"/>

                 
                    <Label Text="Nueva contraseña" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Entry x:Name="EntryPassword"
                           Placeholder="Dejar vacío si no desea cambiar" 
                           IsPassword="True"
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827"
                           IsEnabled="{Binding PuedeEditar}"
                           BackgroundColor="#F9FAFB" HeightRequest="50"/>
                    <Label Text="Mínimo 6 caracteres para actualizar." FontSize="10" TextColor="#9CA3AF" Margin="0,-8,0,0"/>

                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 14" 
                    Stroke="#E5E7EB" 
                    BackgroundColor="#FAFBFC" 
                    Padding="18"
                    IsVisible="{Binding EsDuenoNegocio}">

                <VerticalStackLayout Spacing="14">
                    <Label Text="💼 Configuración del Negocio" FontSize="17" FontAttributes="Bold" TextColor="#2563EB"/>


                    <Label Text="Foto de perfil" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Label Text="Sube una foto clara de tu rostro" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,5"/>
                    <Border x:Name="FrameFotoPerfil" 
                            Stroke="#E5E7EB" StrokeShape="RoundRectangle 12" 
                            BackgroundColor="#F9FAFB" Padding="16">
                        <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                            <Image Source="profile picture.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Seleccionar foto" FontSize="16" TextColor="#2563EB" FontAttributes="Bold"/>
                                <Label x:Name="LabelFotoStatus" Text="Ninguna foto seleccionada" FontSize="12" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>


                    <Label Text="Modalidad de atención" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border x:Name="FrameSede" Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" BackgroundColor="White" Padding="10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Image Source="business.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="Sede" FontSize="12" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="FrameDomicilio" Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" BackgroundColor="White" Padding="10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Image Source="location_on.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="A domicilio" FontSize="12" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="FrameMixta" Grid.Column="2" StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" BackgroundColor="White" Padding="10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Image Source="mix.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="Mixta" FontSize="12" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

     
                    <Label Text="Nombre del negocio" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding NombreNegocio}" Placeholder="Ej: Barbería El Pele" 
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" HeightRequest="50"/>

                    <Label Text="Ubicación exacta" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Direccion}" Placeholder="Dirección de tu negocio" 
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" HeightRequest="50"/>

                    <Label Text="Número RUC" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Ruc}" Placeholder="J0000000000" 
                           PlaceholderColor="#9CA3AF"
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" HeightRequest="50"/>

                 
                    <Label Text="Horario de Atención" TextColor="#111827" FontSize="17" FontAttributes="Bold" Margin="0,20,0,15"/>

                    <Border BackgroundColor="#FAFBFC" Stroke="#E5E7EB" StrokeShape="RoundRectangle 14" Padding="18">
                        <CollectionView ItemsSource="{Binding ListaHorarios}" VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:HorarioTrabajoVm">
                                    <VerticalStackLayout Spacing="8" Padding="0,0,0,15">

                                 
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <CheckBox Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"
                                                      IsChecked="{Binding EsLaboral}"/>

                                            <Label Grid.Column="1" Text="{Binding Dia}" FontSize="15" TextColor="#1F2937" 
                                                   FontAttributes="Bold" VerticalOptions="Center"/>

                                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>

                                     
                                            <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" 
                                                    Padding="4,3" VerticalOptions="Center">
                                                <Switch IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95"/>
                                            </Border>

                                            <Label Grid.Column="4" Text="Pausa" FontSize="12" TextColor="#6B7280" 
                                                   VerticalOptions="Center" Margin="4,0,0,0"/>
                                        </Grid>

                                      
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding EsLaboral}">
                                            <TimePicker Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" 
                                                        Time="{Binding HoraInicio}" HeightRequest="44" HorizontalOptions="FillAndExpand"/>

                                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>

                                            <TimePicker Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" 
                                                        Time="{Binding HoraFin}" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                        </HorizontalStackLayout>

                                        <BoxView HeightRequest="1" Color="#F3F4F6" Margin="0,5,0,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

             
                    <Label Text="Documentos de Verificación" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Border Stroke="#2563EB" StrokeShape="RoundRectangle 12" BackgroundColor="#EFF6FF" Padding="20">
                        <Button Text="Subir PDF" BackgroundColor="Transparent" TextColor="#2563EB" 
                                FontAttributes="Bold" FontSize="16" Command="{Binding SubirPdfCommand}"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

           
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20,0,40">

               
                <Button Grid.Column="0"
                        Text="Cancelar" 
                        BackgroundColor="Transparent" 
                        TextColor="#6B7280"
                        BorderColor="#E5E7EB"
                        BorderWidth="1"
                        FontAttributes="Bold" 
                        CornerRadius="12" 
                        HeightRequest="50"
                        Clicked="OnCancelarClicked"/>

              
                <Button Grid.Column="1"
                        Text="Guardar Cambios" 
                        BackgroundColor="#2563EB" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="12" 
                        HeightRequest="50"
                        Command="{Binding GuardarCambiosCommand}"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>