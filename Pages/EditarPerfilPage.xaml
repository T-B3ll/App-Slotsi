<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.EditarPerfilPage"
             Title="Mi Perfil"
             BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- ENCABEZADO -->
            <Label Text="Editar Perfil" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
            <Label Text="Actualiza tu información personal y de negocio" FontSize="14" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <!-- TARJETA 1: DATOS PERSONALES (SOLO INFO BÁSICA) -->
            <Border StrokeShape="RoundRectangle 14" 
                    Stroke="#E5E7EB" 
                    BackgroundColor="#FAFBFC" 
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos Personales" FontSize="17" FontAttributes="Bold" TextColor="#111827"/>

                    <Label Text="Nombre completo" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Nombre}" Placeholder="Ingresa tu nombre completo" PlaceholderColor="#9CA3AF" 
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                           HeightRequest="50" Margin="0,0,0,5"/>

                    <Label Text="Correo electrónico" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Email}" IsReadOnly="True" Opacity="0.7"
                           TextColor="#111827" FontSize="16" BackgroundColor="#F3F4F6" 
                           HeightRequest="50" Margin="0,0,0,5"/>

                    <Label Text="Teléfono" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Telefono}" Placeholder="+505 234 5678" Keyboard="Telephone" 
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                           HeightRequest="50" Margin="0,0,0,5"/>

                    <Label Text="Nueva contraseña" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F9FAFB" Padding="12,0">
                        <Entry Text="{Binding Password}" Placeholder="Dejar vacío si no desea cambiar" 
                               IsPassword="True" PlaceholderColor="#9CA3AF" TextColor="#111827" 
                               FontSize="16" BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- TARJETA 2: CONFIGURACIÓN DEL NEGOCIO (CON FOTO DE PERFIL Y HORARIOS) -->
            <Border StrokeShape="RoundRectangle 14" 
                    Stroke="#E5E7EB" 
                    BackgroundColor="#FAFBFC" 
                    Padding="18"
                    IsVisible="{Binding EsDuenoNegocio}">

                <VerticalStackLayout Spacing="14">
                    <Label Text="💼 Configuración del Negocio" FontSize="17" FontAttributes="Bold" TextColor="#2563EB"/>

                    <!-- ✅ FOTO DE PERFIL (CORREGIDO: NO ES LOGO) -->
                    <Label Text="Foto de perfil" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Label Text="Sube una foto clara de tu rostro" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,5"/>

                    <Border x:Name="FrameFotoPerfil" 
                            Stroke="#E5E7EB" 
                            StrokeShape="RoundRectangle 12" 
                            BackgroundColor="#F9FAFB" 
                            Padding="16">
                        <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                            <!-- Icono de persona -->
                            <Image Source="profile picture.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Seleccionar foto" FontSize="16" TextColor="#2563EB" FontAttributes="Bold"/>
                                <Label x:Name="LabelFotoStatus" Text="Ninguna foto seleccionada" FontSize="12" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Modalidad -->
                    <Label Text="Modalidad de atención" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border x:Name="FrameSede" Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" BackgroundColor="White" Padding="10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Image Source="business.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="Sede" FontSize="12" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="FrameDomicilio" Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" BackgroundColor="White" Padding="10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Image Source="location_on.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="A domicilio" FontSize="12" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="FrameMixta" Grid.Column="2" StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" BackgroundColor="White" Padding="10">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Image Source="mix.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="Mixta" FontSize="12" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="Nombre del negocio" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding NombreNegocio}" Placeholder="Ej: Barbería El Pele" 
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" HeightRequest="50"/>

                    <Label Text="Ubicación exacta" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Direccion}" Placeholder="Dirección de tu negocio" 
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" HeightRequest="50"/>

                    <Label Text="Número RUC" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
                    <Entry Text="{Binding Ruc}" Placeholder="J0000000000" 
                           TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" HeightRequest="50"/>

                    <!-- ✅ HORARIOS COMPLETOS INTEGRADOS (LUNES A DOMINGO) -->
                    <Label Text="Horario de Atención" TextColor="#111827" FontSize="17" FontAttributes="Bold" Margin="0,20,0,15"/>
                    <Border BackgroundColor="#FAFBFC" Stroke="#E5E7EB" StrokeShape="RoundRectangle 14" Padding="18">
                        <VerticalStackLayout Spacing="14">

                            <!-- LUNES -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckLun" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Lunes" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchLun" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckLun}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Lun_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Lun_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchLun}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchLun}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Lun_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Lun_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>

                            <!-- MARTES -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckMar" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Martes" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchMar" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckMar}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Mar_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Mar_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchMar}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchMar}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Mar_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Mar_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>

                            <!-- MIÉRCOLES -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckMie" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Miércoles" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchMie" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckMie}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Mie_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Mie_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchMie}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchMie}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Mie_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Mie_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>

                            <!-- JUEVES -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckJue" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Jueves" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchJue" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckJue}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Jue_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Jue_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchJue}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchJue}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Jue_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Jue_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>

                            <!-- VIERNES -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckVie" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Viernes" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchVie" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckVie}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Vie_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Vie_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchVie}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchVie}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Vie_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Vie_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>

                            <!-- SÁBADO -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckSab" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Sábado" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchSab" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckSab}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Sab_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Sab_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchSab}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchSab}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Sab_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Sab_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>

                            <!-- DOMINGO -->
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <CheckBox x:Name="CheckDom" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                                    <Label Text="Domingo" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                                    <Border Grid.Column="3" BackgroundColor="#4B5563" StrokeShape="RoundRectangle 16" Padding="4,3" VerticalOptions="Center">
                                        <Switch x:Name="SwitchDom" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckDom}, Path=IsChecked}">
                                    <TimePicker x:Name="TP_Dom_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Dom_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference SwitchDom}, Path=IsToggled}" IsEnabled="{Binding Source={x:Reference SwitchDom}, Path=IsToggled}">
                                    <TimePicker x:Name="TP_Dom_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                    <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                                    <TimePicker x:Name="TP_Dom_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Documentos PDF -->
                    <Label Text="Documentos de Verificación" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Border Stroke="#2563EB" StrokeShape="RoundRectangle 12" BackgroundColor="#EFF6FF" Padding="20">
                        <Button Text="Subir PDF" BackgroundColor="Transparent" TextColor="#2563EB" 
                                FontAttributes="Bold" FontSize="16" Command="{Binding SubirPdfCommand}"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- BOTÓN GUARDAR -->
            <Button Text="Guardar Cambios" BackgroundColor="#2563EB" TextColor="White" 
                    FontAttributes="Bold" CornerRadius="12" HeightRequest="50"
                    Command="{Binding GuardarCambiosCommand}"
                    Margin="0,20,0,40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>