<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.RecuperarContra"
             Title="Recuperar Contraseña"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="CenterAndExpand">

            <Button Text="← Atrás" 
                    BackgroundColor="Transparent" 
                    TextColor="#2563EB" 
                    FontSize="17"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Padding="0"
                    Margin="0,-20,0,0"
                    Clicked="OnBackClicked"/>

            <Frame WidthRequest="80" HeightRequest="80" CornerRadius="40" 
                   BackgroundColor="#EFF6FF" HasShadow="False" 
                   Padding="0" HorizontalOptions="Center" Margin="0,20,0,10">
                <Image Source="icon_lock.png" 
                       WidthRequest="40" HeightRequest="40" 
                       Aspect="AspectFit" 
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>

            <Label Text="¿Olvidaste tu contraseña?" 
                   FontSize="24" FontAttributes="Bold" TextColor="#111827" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Ingresa tu correo electrónico y te enviaremos un código de verificación para restaurar tu acceso." 
                   FontSize="14" TextColor="#6B7280" 
                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                   Margin="0,0,0,20"/>

            <Label Text="Correo electrónico" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>

            <Frame BackgroundColor="#F9FAFB" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="icon_mail.png" 
                           Grid.Column="0" 
                           WidthRequest="24" HeightRequest="24" 
                           Aspect="AspectFit" 
                           VerticalOptions="Center" Margin="0,0,10,0"/>
                    <Entry x:Name="EntryCorreo" Grid.Column="1" Placeholder="ejemplo@gmail.com" 
                           Keyboard="Email" PlaceholderColor="#9CA3AF" TextColor="#111827" 
                           FontSize="16" BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Button Text="Enviar código" 
                    BackgroundColor="#2563EB" TextColor="White" 
                    FontAttributes="Bold" FontSize="16"
                    HeightRequest="56" CornerRadius="12"
                    Margin="0,10,0,0"
                    Clicked="OnEnviarCodigoClicked"/>

            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,20,0,20"/>

            <Label Text="Código de verificación" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>

            <Frame BackgroundColor="#F9FAFB" BorderColor="Transparent" CornerRadius="12" Padding="16,0" HeightRequest="56" HasShadow="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="icon_key.png" 
                           Grid.Column="0" 
                           WidthRequest="24" HeightRequest="24" 
                           Aspect="AspectFit" 
                           VerticalOptions="Center" Margin="0,0,10,0"/>
                    <Entry x:Name="EntryCodigo" Grid.Column="1" Placeholder="------" 
                           Keyboard="Numeric" MaxLength="6" PlaceholderColor="#9CA3AF" 
                           TextColor="#111827" FontSize="18" CharacterSpacing="5"
                           BackgroundColor="Transparent" VerticalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </Grid>
            </Frame>

            <Button Text="Seguir" 
                    BackgroundColor="White" TextColor="#2563EB" 
                    BorderColor="#2563EB" BorderWidth="2"
                    FontAttributes="Bold" FontSize="16"
                    HeightRequest="56" CornerRadius="12"
                    Margin="0,20,0,0"
                    Clicked="OnSeguirClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>