<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.CatalogoCliente"
             Title="Clientes"
             BackgroundColor="#F9FAFB"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="15" BackgroundColor="#FFFFFF">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="¿Qué te harás hoy?" FontSize="24" FontAttributes="Bold" TextColor="#111827" />

            </Grid>

            <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#F3F4F6" Padding="12,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Entry Placeholder="Buscar cortes, barba, tintes..." PlaceholderColor="#9CA3AF" FontSize="14" HeightRequest="45" BackgroundColor="Transparent"/>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Todos" BackgroundColor="#2563EB" TextColor="White" CornerRadius="20" HeightRequest="35" Padding="15,0"/>
                    <Button Text="Cortes" BackgroundColor="#E5E7EB" TextColor="#374151" CornerRadius="20" HeightRequest="35" Padding="15,0"/>
                    <Button Text="Barba" BackgroundColor="#E5E7EB" TextColor="#374151" CornerRadius="20" HeightRequest="35" Padding="15,0"/>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Padding="16,10,16,20">
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="15">

                <!-- Tarjeta de Servicio 1 -->
                <Border Grid.Row="0" Grid.Column="0" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Grid HeightRequest="120" BackgroundColor="#E5E7EB">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label FontFamily="MaterialIcons" Text="&#xe3f4;" FontSize="32" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                                <Label Text="Imagen" FontSize="12" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Padding="12" Spacing="5">
                            <Label Text="Corte Clásico" FontSize="14" FontAttributes="Bold" TextColor="#1F2937" />
                            <Label Text="30 min" FontSize="12" TextColor="#6B7280" />
                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0" VerticalOptions="End">
                                <Label Grid.Column="0" Text="$25" FontSize="16" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="Agendar" BackgroundColor="#2563EB" TextColor="White" FontSize="11" CornerRadius="8" Padding="10,0" HeightRequest="30"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Grid HeightRequest="120" BackgroundColor="#E5E7EB">
     
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label FontFamily="MaterialIcons" Text="&#xe3f4;" FontSize="32" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                                <Label Text="Imagen" FontSize="12" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Padding="12" Spacing="5">
                            <Label Text="Barba Premium" FontSize="14" FontAttributes="Bold" TextColor="#1F2937" />
                            <Label Text="45 min" FontSize="12" TextColor="#6B7280" />
                            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0" VerticalOptions="End">
                                <Label Grid.Column="0" Text="$40" FontSize="16" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="Agendar" BackgroundColor="#2563EB" TextColor="White" FontSize="11" CornerRadius="8" Padding="10,0" HeightRequest="30"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>