<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.PagoSuscripcionPage"
             BackgroundColor="#F9FAFB"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="480" HorizontalOptions="Center">

            <VerticalStackLayout Spacing="4">
                <Label Text="Pago de Suscripción" FontSize="24" FontAttributes="Bold" TextColor="#111827"/>
                <Label Text="Activa tu plan mensual para acceder a todas las funciones." 
                       FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>


            <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Plan Mensual Premium" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                        <Label Text="Próximo cobro: 27 Oct, 2026" FontSize="13" TextColor="#F59E0B"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="$5 USD" FontSize="24" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center"/>
                </Grid>
            </Border>


            <VerticalStackLayout Spacing="16">

        
                <VerticalStackLayout Spacing="6">
                    <Label Text="Número de tarjeta" FontSize="13" TextColor="#6B7280"/>
                    <Border x:Name="BorderCard" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="16,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntryCard" Placeholder="0000 0000 0000 0000" FontSize="16" HeightRequest="50" BackgroundColor="Transparent" Keyboard="Numeric"/>
                    </Border>
                </VerticalStackLayout>

          
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Vencimiento" FontSize="13" TextColor="#6B7280"/>
                        <Border x:Name="BorderExpiry" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="EntryExpiry" Placeholder="MM/AA" FontSize="16" HeightRequest="50" BackgroundColor="Transparent" Keyboard="Text"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="CVV" FontSize="13" TextColor="#6B7280"/>
                        <Border x:Name="BorderCvv" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="EntryCvv" IsPassword="True" Placeholder="123" FontSize="16" HeightRequest="50" BackgroundColor="Transparent" Keyboard="Numeric"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

         
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nombre del titular" FontSize="13" TextColor="#6B7280"/>
                    <Border x:Name="BorderName" Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="16,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntryName" Placeholder="Como aparece en la tarjeta" FontSize="16" HeightRequest="50" BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

  
            <Label Text="🔒 Pago simulado seguro - No se procesan datos reales" 
                   FontSize="12" TextColor="#6B7280" HorizontalTextAlignment="Center" Margin="0,8,0,0"/>

     
            <Button x:Name="BtnPagar" 
                    Text="Pagar $5 USD" BackgroundColor="#2563EB" TextColor="White" 
                    FontSize="16" FontAttributes="Bold" CornerRadius="14" HeightRequest="55" 
                    Clicked="OnPagarClicked" Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>