<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.ListaTrabajadores"
             Title="ListaTrabajadores"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">

        <Label Grid.Row="0" 
               Text="Lista de Trabajadores" 
               FontSize="22" 
               FontAttributes="Bold" 
               TextColor="#2563EB" 
               Margin="20,16,20,8" />
        
        <Button Text="+"
                FontSize="30" 
                FontAttributes="Bold"
                TextColor="White" 
                BackgroundColor="#2563EB" 
                WidthRequest="60" 
                HeightRequest="60" 
                CornerRadius="30"
                HorizontalOptions="End" 
                VerticalOptions="End" 
                Margin="0,0,20,30"
                Command="{Binding IrANuevoTrabajadorCommand}"/>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Trabajadores}" 
                        Margin="16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E2E8F0" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 12" 
                            BackgroundColor="White" 
                            Margin="0,0,0,12" 
                            Padding="12">

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">

                            <Border Grid.Column="0" 
                                    WidthRequest="56" 
                                    HeightRequest="56" 
                                    StrokeShape="RoundRectangle 28" 
                                    StrokeThickness="0" 
                                    VerticalOptions="Center">
                                <Image Source="{Binding Foto, FallbackValue='profile_picture.png'}" Aspect="AspectFill" />
                            </Border>
                      
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Image Source="icon_user.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="8">
                                    <Image Source="icon_phone.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="{Binding Especialidad}" FontSize="13" TextColor="#475569" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="8">
                                    <Image Source="icon_email.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="{Binding Correo}" FontSize="13" TextColor="#475569" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="10" HorizontalOptions="End">
                                <Switch IsToggled="{Binding Activo}" OnColor="#2563EB" HorizontalOptions="End"/>
                                <HorizontalStackLayout Spacing="15" HorizontalOptions="End">
                                    <ImageButton BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24">
                                        <ImageButton.Source>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Color="#2563EB" Size="24"/>
                                        </ImageButton.Source>
                                    </ImageButton>

                                    <ImageButton BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24">
                                        <ImageButton.Source>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Color="#EF4444" Size="24"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>