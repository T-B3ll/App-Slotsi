<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             xmlns:models="clr-namespace:slotsi_citas.Models"
             x:Class="slotsi_citas.Pages.CalendarioPage"
             x:Name="PageRoot"
             Title="Calendario de citas..."
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <!-- NUEVO ENCABEZADO CON MENÚ Y BOTÓN ATRÁS -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="#2563EB" Spacing="0">

            <!-- Fila 1: Menú y Título -->
            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,12">
                <ImageButton Grid.Column="0" BackgroundColor="Transparent" Clicked="OnMenuClicked" WidthRequest="24" HeightRequest="24">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE5D2;" Color="White" Size="26"/>
                    </ImageButton.Source>
                </ImageButton>
                <Label Grid.Column="1" Text="Calendario de citas..." FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                <BoxView Grid.Column="2" WidthRequest="24" Color="Transparent"/>
            </Grid>

            <!-- Fila 2: Botón Atrás y Selector de Fecha -->
            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,0,16,16" ColumnSpacing="8">
                <ImageButton Grid.Column="0" BackgroundColor="Transparent" Command="{Binding VolverCommand}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xE5C4;" Color="White" Size="24"/>
                    </ImageButton.Source>
                </ImageButton>

                <Border Grid.Column="1" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="42" Padding="12,0">
                    <Grid>
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding TextoFechaSeleccionada}" FontSize="13" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center" MaxLines="1"/>
                            <Image Grid.Column="1" Source="calendar.png" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <DatePicker Date="{Binding FechaSeleccionada, Mode=TwoWay}" Opacity="0.01" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="42" Padding="16,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding HoyCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="Hoy" TextColor="#111827" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- RESTO DEL CUERPO (LISTA DE HORARIOS) -->
        <Grid Grid.Row="1" BackgroundColor="#FFFFFF">
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" Color="#2563EB" HorizontalOptions="Center" VerticalOptions="Center"/>

            <VerticalStackLayout IsVisible="{Binding EstaCerradoElDia}" VerticalOptions="Center" HorizontalOptions="Center" Padding="30" Spacing="12">
                <Border BackgroundColor="#FEF2F2" Stroke="#FEE2E2" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="&#xE88F;" FontFamily="MaterialIcons" FontSize="36" TextColor="#DC2626" HorizontalOptions="Center"/>
                        <Label Text="Negocio Cerrado" FontSize="16" FontAttributes="Bold" TextColor="#991B1B" HorizontalOptions="Center"/>
                        <Label Text="{Binding MensajeCerrado}" FontSize="13" TextColor="#B91C1C" HorizontalTextAlignment="Center"/>
                        <Label Text="Por favor selecciona otra fecha disponible." FontSize="12" TextColor="#6B7280" HorizontalTextAlignment="Center" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding RangosHorarios}" IsVisible="{Binding EstaAbiertoElDia}" Margin="16,12" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RangoHorario">
                        <Grid ColumnDefinitions="75, *">
                            <Label Grid.Column="0" Text="{Binding HoraDisplay}" FontSize="13" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center"/>

                            <Border Grid.Column="1" IsVisible="{Binding EsDisponible}" BackgroundColor="#FFFFFF" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="48" Padding="16,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.AgendarHorarioCommand, Source={x:Reference PageRoot}}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding EstadoTexto}" TextColor="#111827" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Border>

                            <Border Grid.Column="1" IsVisible="{Binding EsNoDisponible}" BackgroundColor="#F1F5F9" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="48" Padding="0">
                                <Grid ColumnDefinitions="4, *">
                                    <BoxView Grid.Column="0" Color="#64748B" CornerRadius="12,0,0,12"/>
                                    <VerticalStackLayout Grid.Column="1" Padding="14,0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="No disponible" TextColor="#334155" FontSize="12" FontAttributes="Bold"/>
                                        <Label Text="{Binding DetallePausa}" TextColor="#64748B" FontSize="10"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" IsVisible="{Binding EsOcupado}" BackgroundColor="#FEF2F2" Stroke="#FEE2E2" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="55" Padding="0">
                                <Grid ColumnDefinitions="4, *, Auto">
                                    <BoxView Grid.Column="0" Color="#EF4444" CornerRadius="12,0,0,12"/>
                                    <VerticalStackLayout Grid.Column="1" Padding="14,0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="Ocupado" TextColor="#991B1B" FontSize="12" FontAttributes="Bold"/>
                                        <Label Text="{Binding Cita.Cliente.Nombre, StringFormat='Cliente: {0}'}" TextColor="#DC2626" FontSize="10" IsVisible="{Binding EsMiCita}"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4" Padding="0,0,8,0" IsVisible="{Binding EsMiCita}">
                                        <ImageButton WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent"
                                                     Command="{Binding BindingContext.EditarCitaCommand, Source={x:Reference PageRoot}}"
                                                     CommandParameter="{Binding .}">
                                            <ImageButton.Source>
                                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Color="#2563EB" Size="18"/>
                                            </ImageButton.Source>
                                        </ImageButton>

                                        <ImageButton WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent"
                                                     Command="{Binding BindingContext.EliminarCitaCommand, Source={x:Reference PageRoot}}"
                                                     CommandParameter="{Binding .}">
                                            <ImageButton.Source>
                                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Color="#EF4444" Size="18"/>
                                            </ImageButton.Source>
                                        </ImageButton>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>