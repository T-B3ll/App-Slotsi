<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             x:Class="slotsi_citas.Pages.CalendarioPage"
             x:Name="PageRoot"
             Title="Calendario"
             BackgroundColor="White">

    <ContentPage.BindingContext>
        <vm:CalendarioViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!-- 1. Título principal -->
        <Label Grid.Row="0"
               Text="Calendario"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#2F6BFF"
               HorizontalOptions="Center"
               Margin="0,15,0,15" />

        <!-- 2. Navegador de Fecha y Botón Hoy -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *, Auto" Padding="20,0" Margin="0,0,0,15">
            <Label Grid.Column="0" Text="&lt;" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AnterioresCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="{Binding RangoFecha}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1C1C1E"
                   VerticalOptions="Center"
                   Margin="10,0" />

            <Label Grid.Column="2" Text="&gt;" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SiguientesCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Botón Hoy -->
            <Border Grid.Column="3"
                    BackgroundColor="#2F6BFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding HoyCommand}" />
                </Border.GestureRecognizers>
                <Label Text="Hoy" TextColor="White" FontAttributes="Bold" FontSize="13" />
            </Border>
        </Grid>

        <!-- 3. Franja de días de la semana -->
        <StackLayout Grid.Row="2">
            <BoxView HeightRequest="1" BackgroundColor="#E5E5EA" />
            <CollectionView ItemsSource="{Binding DiasSemana}" HorizontalScrollBarVisibility="Never" Margin="10,10">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout WidthRequest="38" HorizontalOptions="Center">
                            <Label Text="{Binding LetraDia}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1C1C1E"
                                   HorizontalOptions="Center" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="{Binding ColorFondoNumero}"
                                    StrokeShape="RoundRectangle 18"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    Margin="0,4,0,0"
                                    HorizontalOptions="Center">
                                <Label Text="{Binding NumeroDia}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{Binding ColorTextoNumero}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <BoxView HeightRequest="1" BackgroundColor="#E5E5EA" />
        </StackLayout>

        <!-- 4. Lista Dinámica de Horarios (Sin la propiedad Padding en CollectionView) -->
        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding RangosHorarios}" 
                        Margin="15,10"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="70, *" Margin="0,5">
                        <!-- Columna con la Hora -->
                        <Label Grid.Column="0" 
                               Text="{Binding HoraDisplay}" 
                               TextColor="#1C1C1E" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <!-- Tarjeta con la acción/estado -->
                        <Border Grid.Column="1"
                                BackgroundColor="#F8F9FA"
                                Stroke="#E5E5EA"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="15,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.SeleccionarHorarioCommand, Source={x:Reference PageRoot}}" 
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Label Text="{Binding EstadoTexto}" 
                                   TextColor="#2F6BFF" 
                                   FontSize="14" 
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 5. Barra de Navegación Inferior (Bottom Bar) -->
        <Grid Grid.Row="4" ColumnDefinitions="*, *, *, *" BackgroundColor="#F9F9F9" Padding="0,10,0,15">
            <BoxView Grid.ColumnSpan="4" HeightRequest="1" BackgroundColor="#E5E5EA" VerticalOptions="Start" />

            <StackLayout Grid.Column="0" HorizontalOptions="Center">
                <Image Source="home_icon.png" WidthRequest="22" HeightRequest="22" />
                <Label Text="Inicio" FontSize="11" TextColor="#8E8E93" HorizontalOptions="Center" Margin="0,2,0,0" />
            </StackLayout>

            <StackLayout Grid.Column="1" HorizontalOptions="Center">
                <Image Source="calendar_icon.png" WidthRequest="22" HeightRequest="22" />
                <Label Text="Citas" FontSize="11" TextColor="#2F6BFF" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,2,0,0" />
            </StackLayout>

            <StackLayout Grid.Column="2" HorizontalOptions="Center">
                <Image Source="location_icon.png" WidthRequest="22" HeightRequest="22" />
                <Label Text="Sucursal" FontSize="11" TextColor="#8E8E93" HorizontalOptions="Center" Margin="0,2,0,0" />
            </StackLayout>

            <StackLayout Grid.Column="3" HorizontalOptions="Center">
                <Image Source="profile_icon.png" WidthRequest="22" HeightRequest="22" />
                <Label Text="Perfil" FontSize="11" TextColor="#8E8E93" HorizontalOptions="Center" Margin="0,2,0,0" />
            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>