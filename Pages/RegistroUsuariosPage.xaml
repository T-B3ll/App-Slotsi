<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             xmlns:models="clr-namespace:slotsi_citas.Models"
             x:Class="slotsi_citas.Pages.RegistroUsuariosPage"
             x:DataType="vm:RegistroUsuariosViewModel"
             Title="Registro de usuarios"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:RegistroUsuariosViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">

        <!-- Header / Barra Superior -->
        <Grid Grid.Row="0" Padding="20,16,20,12" ColumnDefinitions="Auto, *" BackgroundColor="#FFFFFF">
            <ImageButton Grid.Column="0" 
                         Source="arrow_back.png" 
                         HeightRequest="24" 
                         WidthRequest="24" 
                         BackgroundColor="Transparent"
                         Command="{Binding RegresarCommand}"
                         VerticalOptions="Center"/>

            <Label Grid.Column="1" 
                   Text="Registro de usuarios" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#111827" 
                   Margin="12,0,0,0" 
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="1" Padding="20,8">
            <VerticalStackLayout Spacing="24">

                <!-- Filtro y Búsqueda -->
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Buscar por inicial"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#111827" />
                        <Label Text="Filtra la lista por letra"
                               FontSize="12"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <!-- Lista Dinámica de Iniciales (Alfabeto) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Iniciales}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InicialLetraModel">
                                    <Border WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnLetraTapped"/>
                                        </Border.GestureRecognizers>

                                        <Border.Triggers>
                                            <!-- Si está seleccionada: Fondo y Borde Azul (#2563EB) -->
                                            <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#2563EB" />
                                                <Setter Property="Stroke" Value="#2563EB" />
                                            </DataTrigger>
                                            <!-- Si no está seleccionada: Fondo Blanco y Borde Gris (#E5E7EB) -->
                                            <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionada}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                                <Setter Property="Stroke" Value="#E5E7EB" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="{Binding Letra}" 
                           FontAttributes="Bold"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                                            <Label.Triggers>
                                                <!-- Texto blanco si está seleccionada -->
                                                <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionada}" Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                                <!-- Texto oscuro si no está seleccionada -->
                                                <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionada}" Value="False">
                                                    <Setter Property="TextColor" Value="#111827" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Campo de Búsqueda -->
                    <VerticalStackLayout Spacing="4">
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,4"
                                BackgroundColor="#FFFFFF">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0"
                                       Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                       Placeholder="Buscar usuarios"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="#111827"
                                       FontSize="14" 
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="1"
                                       Source="search_icon.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Nombre, correo o cédula"
                               FontSize="11"
                               TextColor="#6B7280"
                               Margin="4,0,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Lista de Usuarios Existentes usando BindableLayout dentro del ScrollView -->
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Usuarios existentes"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#111827" />
                        <Label Text="Resultados sincronizados con la app"
                               FontSize="12"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Usuarios}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Usuario">
                                <Grid Padding="0,12" ColumnDefinitions="Auto, *, Auto">
                                    <BoxView Grid.ColumnSpan="3"
                                             HeightRequest="1"
                                             BackgroundColor="#F3F4F6"
                                             VerticalOptions="End" />

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" 
                                            WidthRequest="42" 
                                            HeightRequest="42" 
                                            StrokeShape="RoundRectangle 21" 
                                            BackgroundColor="#E5E7EB" 
                                            StrokeThickness="0"
                                            Margin="0,0,12,0"
                                            VerticalOptions="Center">
                                        <Image Source="profile_placeholder.png" Aspect="AspectFill"/>
                                    </Border>

                                    <!-- Datos de MongoDB: NombreCompleto y Correo -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding NombreCompleto}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#111827" />
                                        <Label Text="{Binding Correo}"
                                               FontSize="12"
                                               TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <!-- Cédula desde MongoDB -->
                                    <Label Grid.Column="2"
                                           Text="{Binding Cedula}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#4B5563"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Botones de Acción -->
                <VerticalStackLayout Spacing="10" Margin="0,0,0,16">
                    <Button Text="Ver detalles" 
                            TextColor="#4B5563" 
                            BackgroundColor="#FFFFFF" 
                            BorderColor="#E5E7EB" 
                            BorderWidth="1" 
                            CornerRadius="10" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            HeightRequest="44"
                            Command="{Binding VerDetallesCommand}" />

                    <Button Text="Importar lista" 
                            TextColor="#4B5563" 
                            BackgroundColor="#FFFFFF" 
                            BorderColor="#E5E7EB" 
                            BorderWidth="1" 
                            CornerRadius="10" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            HeightRequest="44"
                            Command="{Binding ImportarListaCommand}" />

                    <Button Text="Registrar nuevo usuario" 
                            TextColor="#FFFFFF" 
                            BackgroundColor="#2563EB" 
                            CornerRadius="12" 
                            FontAttributes="Bold" 
                            FontSize="15"
                            HeightRequest="48"
                            Command="{Binding RegistrarNuevoCommand}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>