<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             xmlns:models="clr-namespace:slotsi_citas.Models"
             x:Class="slotsi_citas.Pages.RegistroUsuariosPage"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             x:DataType="vm:RegistroUsuariosViewModel"
             x:Name="PageRoot"
             Title="Registro de usuarios"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="20,44,20,16"
              ColumnDefinitions="Auto, *"
              BackgroundColor="#2563EB">
            <ImageButton Grid.Column="0"
                         Source="arrow_back.png"
                         HeightRequest="24"
                         WidthRequest="24"
                         BackgroundColor="Transparent"
                         Command="{Binding RegresarCommand}"
                         VerticalOptions="Center"/>
            <Label Grid.Column="1"
                   Text="Registro de usuarios"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   Margin="12,0,0,0"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Contenido Principal (SIN ScrollView externo) -->
        <Grid Grid.Row="1" Padding="20,16">
            <Grid RowDefinitions="Auto, *">

                <!-- Filtros y Búsqueda -->
                <VerticalStackLayout Grid.Row="0" Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Buscar por inicial" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                        <Label Text="Filtra la lista por letra" FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <!-- Lista Dinámica de Iniciales -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Iniciales}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InicialLetraModel">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnLetraTapped"/>
                                        </Border.GestureRecognizers>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionada}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#2563EB" />
                                                <Setter Property="Stroke" Value="#2563EB" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionada}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                                <Setter Property="Stroke" Value="#E5E7EB" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="{Binding Letra}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionada}" Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionada}" Value="False">
                                                    <Setter Property="TextColor" Value="#111827" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Campo de Búsqueda -->
                    <VerticalStackLayout Spacing="4">
                        <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,4" BackgroundColor="#FFFFFF">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0" Text="{Binding TextoBusqueda, Mode=TwoWay}" Placeholder="Buscar usuarios" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="14" VerticalOptions="Center"/>
                                <Image Grid.Column="1" Source="search_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Nombre, correo o cédula" FontSize="11" TextColor="#6B7280" Margin="4,0,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Lista de Usuarios (CollectionView en lugar de BindableLayout) -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding Usuarios}" Margin="0,10,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Usuario">
                            <Border Stroke="#F3F4F6" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" BackgroundColor="#FFFFFF">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalOptions="Center">

                                    <!-- Avatar Circular -->
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="{Binding ColorAvatar}" StrokeThickness="0" Margin="0,0,12,0" VerticalOptions="Center">
                                        <Label Text="{Binding InicialesNombre}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Datos -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding NombreCompleto}" FontSize="14" FontAttributes="Bold" TextColor="#111827" />
                                        <Label Text="{Binding Correo}" FontSize="12" TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <!-- Botón de Estado (Activo/Inactivo) -->
                                    <Border Grid.Column="2" Padding="14,8" MinimumWidthRequest="80" StrokeShape="RoundRectangle 16" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,8,0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CambiarEstadoCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding EstaActivo}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding EstaActivo}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding EstaActivo}" Value="True">
                                                    <Setter Property="Text" Value="Activo" />
                                                    <Setter Property="TextColor" Value="#166534" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding EstaActivo}" Value="False">
                                                    <Setter Property="Text" Value="Inactivo" />
                                                    <Setter Property="TextColor" Value="#991B1B" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Botón de Detalles (Nuevo) -->
                                    <Border Grid.Column="3" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="#F3F4F6" StrokeThickness="0" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.VerDetallesUsuarioCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="👁" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>