<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             x:Class="slotsi_citas.Pages.RegistroUsuariosPage"
             Title="Registro de usuarios"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:RegistroUsuariosViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="InicialButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="TextColor" Value="#111827" />
                <Setter Property="BorderColor" Value="#E5E7EB" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- Header / Barra Superior -->
        <Grid Grid.Row="0" Padding="20,16,20,12" ColumnDefinitions="Auto, *" BackgroundColor="#FFFFFF">
            <ImageButton Grid.Column="0" 
                         Source="arrow_back.png" 
                         HeightRequest="24" 
                         WidthRequest="24" 
                         BackgroundColor="Transparent"
                         Command="{Binding RegresarCommand}"
                         VerticalOptions="Center"/>

            <Label Grid.Column="1" 
                   Text="Registro de usuarios" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#111827" 
                   Margin="12,0,0,0" 
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="1" Padding="20,8">
            <VerticalStackLayout Spacing="24">

                <!-- Filtro y Búsqueda -->
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Buscar por inicial"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#111827" />
                        <Label Text="Filtra la lista por letra"
                               FontSize="12"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <!-- Lista Dinámica de Iniciales (Alfabeto) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Iniciales}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding .}" 
                                            Style="{StaticResource InicialButtonStyle}"
                                            Command="{Binding BindingContext.FiltrarPorInicialCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Campo de Búsqueda -->
                    <VerticalStackLayout Spacing="4">
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,4"
                                BackgroundColor="#FFFFFF">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0"
                                       Text="{Binding TextoBusqueda}"
                                       Placeholder="Buscar usuarios"
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="#111827"
                                       FontSize="14" 
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="1"
                                       Source="search_icon.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Nombre, correo o ID"
                               FontSize="11"
                               TextColor="#6B7280"
                               Margin="4,0,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Lista de Usuarios Existentes -->
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Usuarios existentes"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#111827" />
                        <Label Text="Resultados sincronizados con la app"
                               FontSize="12"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Usuarios}" 
                                    SelectionMode="Single"
                                    SelectedItem="{Binding UsuarioSeleccionado}"
                                    SelectionChangedCommand="{Binding SeleccionarUsuarioCommand}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,12" ColumnDefinitions="Auto, *, Auto">
                                    <!-- Separador Inferior -->
                                    <BoxView Grid.ColumnSpan="3"
                                             HeightRequest="1"
                                             BackgroundColor="#F3F4F6"
                                             VerticalOptions="End" />

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" 
                                            WidthRequest="42" 
                                            HeightRequest="42" 
                                            StrokeShape="RoundRectangle 21" 
                                            BackgroundColor="#E5E7EB" 
                                            StrokeThickness="0"
                                            Margin="0,0,12,0"
                                            VerticalOptions="Center">
                                        <Image Source="{Binding AvatarUrl, TargetNullValue='profile_placeholder.png'}" Aspect="AspectFill"/>
                                    </Border>

                                    <!-- Información del Usuario -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Nombre}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#111827" />
                                        <Label Text="{Binding Email}"
                                               FontSize="12"
                                               TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <!-- Identificador / Rol -->
                                    <Label Grid.Column="2"
                                           Text="{Binding IdTexto}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#4B5563"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Botones de Acción -->
                <VerticalStackLayout Spacing="10" Margin="0,0,0,16">
                    <Button Text="Ver detalles" 
                            TextColor="#4B5563" 
                            BackgroundColor="#FFFFFF" 
                            BorderColor="#E5E7EB" 
                            BorderWidth="1" 
                            CornerRadius="10" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            HeightRequest="44"
                            Command="{Binding VerDetallesCommand}" />

                    <Button Text="Importar lista" 
                            TextColor="#4B5563" 
                            BackgroundColor="#FFFFFF" 
                            BorderColor="#E5E7EB" 
                            BorderWidth="1" 
                            CornerRadius="10" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            HeightRequest="44"
                            Command="{Binding ImportarListaCommand}" />

                    <Button Text="Registrar nuevo usuario" 
                            TextColor="#FFFFFF" 
                            BackgroundColor="#2563EB" 
                            CornerRadius="12" 
                            FontAttributes="Bold" 
                            FontSize="15"
                            HeightRequest="48"
                            Command="{Binding RegistrarNuevoCommand}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>