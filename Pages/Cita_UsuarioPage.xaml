<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             xmlns:models="clr-namespace:slotsi_citas.Models"
             x:Class="slotsi_citas.Pages.Cita_UsuarioPage"
             x:DataType="vm:Cita_UsuarioViewModel"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False"
             Title="Calendario">

    <ContentPage.BindingContext>
        <vm:Cita_UsuarioViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- 1. Encabezado Azul Superior -->
        <Grid Grid.Row="0" 
              BackgroundColor="#2563EB" 
              HeightRequest="56" 
              Padding="16,0">
            <Label Text="Calendario" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#FFFFFF" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>
        </Grid>

        <!-- 2. Flechas de Semana, Botón de Fecha Exacta y Botón Hoy -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*, Auto" 
              Padding="16,16,16,8" 
              VerticalOptions="Center">

            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center" HorizontalOptions="Start">

                <!-- Flecha Semanal Izquierda < -->
                <Button Text="&lt;" 
                        Clicked="OnSemanaAnteriorClicked"
                        TextColor="#2563EB" 
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="22"
                        WidthRequest="36"
                        HeightRequest="40"
                        Padding="0"/>

                <!-- Botón Azul de Fecha Exacta con DatePicker transparente encima -->
                <Grid VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 10"
                            BackgroundColor="#2563EB"
                            StrokeThickness="0"
                            Padding="12,8">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding TextoFechaBoton, FallbackValue='28 Sep, 2026'}" 
                                   FontSize="13" 
                                   FontAttributes="Bold" 
                                   TextColor="#FFFFFF" 
                                   VerticalOptions="Center"/>
                            <Image Source="calendar.png" HeightRequest="15" WidthRequest="15" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- DatePicker transparente situado SOLO encima del botón azul -->
                    <DatePicker x:Name="MiDatePicker"
                                Date="{Binding FechaSeleccionada, Mode=TwoWay}"
                                Opacity="0.01"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"/>
                </Grid>

                <!-- Flecha Semanal Derecha > -->
                <Button Text="&gt;" 
                        Clicked="OnSemanaSiguienteClicked"
                        TextColor="#2563EB" 
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="22"
                        WidthRequest="36"
                        HeightRequest="40"
                        Padding="0"/>
            </HorizontalStackLayout>

            <!-- Botón Hoy Naranja -->
            <Button Grid.Column="1" 
                    Text="Hoy" 
                    Command="{Binding IrAHoyCommand}"
                    BackgroundColor="#FF9800" 
                    TextColor="White" 
                    CornerRadius="16" 
                    HeightRequest="38" 
                    Padding="16,0" 
                    FontSize="13" 
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- 3. Filtrado Rápido de Días de la Semana -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FechasSemana}"
                        Margin="12,4,12,8"
                        HeightRequest="65">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiaSemanaModel">
                    <Grid WidthRequest="46" RowDefinitions="Auto, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDiaSemanaTapped"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Row="0" 
                               Text="{Binding NombreDia}" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,0,0,4">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionado}" Value="True">
                                    <Setter Property="TextColor" Value="#2563EB" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionado}" Value="False">
                                    <Setter Property="TextColor" Value="#6B7280" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Border Grid.Row="1" 
                                WidthRequest="36" 
                                HeightRequest="36" 
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionado}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#2563EB" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionado}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#F3F4F6" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Label Text="{Binding NumeroDia}" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionado}" Value="True">
                                        <Setter Property="TextColor" Value="#FFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding EsSeleccionado}" Value="False">
                                        <Setter Property="TextColor" Value="#111827" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 4. Lista de Citas Horarias -->
        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding RangosHorarios}" 
                        Margin="16,4">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RangoHorario">
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FAFAFA"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="0">
                        <Grid ColumnDefinitions="6, *">
                            <BoxView Grid.Column="0" CornerRadius="12,0,0,12" Color="#10B981">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Cita.Estado}" Value="Ocupado">
                                        <Setter Property="Color" Value="#F97316" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding Cita.Estado}" Value="NoDisponible">
                                        <Setter Property="Color" Value="#A855F7" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>

                            <VerticalStackLayout Grid.Column="1" Padding="14,10" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" 
                                           Text="{Binding Hora, StringFormat='{0:hh\\:mm\\:ss}'}" 
                                           FontAttributes="Bold" 
                                           FontSize="13" 
                                           TextColor="#6B7280"/>

                                    <Border Grid.Column="1" 
                                            StrokeShape="RoundRectangle 6" 
                                            StrokeThickness="0" 
                                            Padding="8,3"
                                            BackgroundColor="#DCFCE7">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Cita.Estado}" Value="Ocupado">
                                                <Setter Property="BackgroundColor" Value="#FFEDD5" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Cita.Estado}" Value="NoDisponible">
                                                <Setter Property="BackgroundColor" Value="#F3E8FF" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="{Binding Cita.Estado, TargetNullValue='DISPONIBLE', FallbackValue='DISPONIBLE'}" 
                                               FontSize="10" 
                                               FontAttributes="Bold"
                                               TextColor="#15803D">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Cita.Estado}" Value="Ocupado">
                                                    <Setter Property="TextColor" Value="#C2410C" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Cita.Estado}" Value="NoDisponible">
                                                    <Setter Property="TextColor" Value="#7E22CE" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Cita.NombreCliente, FallbackValue='Horario libre'}" 
                                       FontAttributes="Bold" 
                                       FontSize="15" 
                                       TextColor="#111827"/>

                                <Label Text="{Binding Cita.Notas, FallbackValue='Sin asignación'}" 
                                       TextColor="#6B7280" 
                                       FontSize="12"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 5. Barra Inferior de Navegación -->
        <Grid Grid.Row="4" 
              ColumnDefinitions="*,*,*,*" 
              BackgroundColor="#FFFFFF" 
              HeightRequest="56" 
              Padding="0,4">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="home.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Inicio" FontSize="11" TextColor="#9CA3AF"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="calendar.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Citas" FontSize="11" TextColor="#FF9800" FontAttributes="Bold"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="location.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Sucursal" FontSize="11" TextColor="#9CA3AF"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="profile.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Perfil" FontSize="11" TextColor="#9CA3AF"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>