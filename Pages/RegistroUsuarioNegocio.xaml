<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.RegistroUsuarioNegocio"
             Title="Crear cuenta de negocio"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Dueño de negocio" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
            <Label Text="Completa tus datos para crear tu cuenta" FontSize="14" TextColor="#6B7280" Margin="0,-5,0,10"/>
            <Label Text="Los campos que tengan un &quot;*&quot; son obligatorios" FontSize="12" TextColor="#EF4444" Margin="0,0,0,5"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,20">
                <Frame x:Name="FrameSede" Grid.Column="0" CornerRadius="12" BorderColor="#E5E7EB" BackgroundColor="White" Padding="10" HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Frame WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#F3F4F6" HasShadow="False" Padding="0" IsClippedToBounds="True">
                            <Image Source="business.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <Label Text="Sede" FontSize="12" TextColor="#111827" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTipoNegocioSelected" CommandParameter="Sede"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame x:Name="FrameDomicilio" Grid.Column="1" CornerRadius="12" BorderColor="#E5E7EB" BackgroundColor="White" Padding="10" HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Frame WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#F3F4F6" HasShadow="False" Padding="0" IsClippedToBounds="True">
                            <Image Source="location_on.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <Label Text="A domicilio" FontSize="12" TextColor="#111827" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTipoNegocioSelected" CommandParameter="Domicilio"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame x:Name="FrameMixta" Grid.Column="2" CornerRadius="12" BorderColor="#E5E7EB" BackgroundColor="White" Padding="10" HasShadow="False">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Frame WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="#F3F4F6" HasShadow="False" Padding="0" IsClippedToBounds="True">
                            <Image Source="mix.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <Label Text="Mixta" FontSize="12" TextColor="#111827" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTipoNegocioSelected" CommandParameter="Mixta"/>
                    </Frame.GestureRecognizers>
                </Frame>
            </Grid>

            <Label Text="Foto de perfil *" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,5"/>
            <Label Text="Toca el círculo para subir tu foto o logo" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,15"/>

            <AbsoluteLayout HorizontalOptions="Center" WidthRequest="130" HeightRequest="130" Margin="0,0,0,20">

                <Border 
                    AbsoluteLayout.LayoutBounds="0,0,130,130"
                    StrokeShape="RoundRectangle 65" 
                    Stroke="#E5E7EB" 
                    StrokeThickness="2"
                    BackgroundColor="#F9FAFB"
                    Padding="0">

                    <Image 
                        Source="{Binding UrlFotoPerfil}" 
                        Aspect="AspectFill" 
                        HorizontalOptions="Fill" 
                        VerticalOptions="Fill" />

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSubirFotoClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <Border 
                    AbsoluteLayout.LayoutBounds="90,90,40,40"
                    StrokeShape="RoundRectangle 20" 
                    BackgroundColor="#2563EB" 
                    Stroke="White" 
                    StrokeThickness="3"
                    Padding="0">

                    <Image 
                        Source="{FontImageSource FontFamily=MaterialIcons, Glyph='&#xE3AF;', Color=White, Size=20}" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" />

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSubirFotoClicked" />
                    </Border.GestureRecognizers>
                </Border>

            </AbsoluteLayout>

            <Label Text="Nombre completo *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Entry x:Name="EntryNombre" Placeholder="Ingresa tu nombre completo" PlaceholderColor="#9CA3AF" 
                   TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                   HeightRequest="50" Margin="0,0,0,5"/>
            <Label Text="Nombre y apellidos" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Teléfono *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Entry x:Name="EntryTelefono" Placeholder="Ingresa tu número" Keyboard="Telephone" 
                   PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                   HeightRequest="50" Margin="0,0,0,5" TextChanged="OnTelefonoChanged"/>
            <Label Text="Ej: +505 234 5678" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Cédula *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Entry x:Name="EntryCedula" Placeholder="0000-0000-0000" Keyboard="Text" 
                   PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                   HeightRequest="50" Margin="0,0,0,5" TextChanged="OnCedulaChanged"/>
            <Label Text="Sin puntos, espacios ni guiones" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Correo *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Entry x:Name="EntryCorreo" Placeholder="tucorreo@ejemplo.com" Keyboard="Email" 
                   PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                   HeightRequest="50" Margin="0,0,0,5"/>
            <Label Text="Te enviaremos confirmaciones" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Tipo de negocio *" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
            <Frame BackgroundColor="#F9FAFB" BorderColor="Transparent" CornerRadius="8" Padding="12,0" HeightRequest="50" HasShadow="False">
                <Picker x:Name="PickerTipoNegocio" 
                        Title="Selecciona una opción" 
                        TitleColor="#9CA3AF"
                        TextColor="#111827" 
                        FontSize="16" 
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        SelectedIndexChanged="OnTipoNegocioChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Barbería</x:String>
                            <x:String>Salón de Belleza</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Frame>
            <Label Text="Elige según tus servicios principales" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Nombre del negocio *" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
            <Entry x:Name="EntryNombreNegocio" 
                   Placeholder="Ej: Barbería El Pele" 
                   PlaceholderColor="#9CA3AF" 
                   TextColor="#111827" 
                   FontSize="16" 
                   BackgroundColor="#F9FAFB" 
                   HeightRequest="50" 
                   Margin="0,0,0,5"/>
            <Label Text="Como aparecerá en la aplicación" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Contraseña *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Frame BackgroundColor="#F9FAFB" BorderColor="Transparent" CornerRadius="8" Padding="12,0" HeightRequest="50" HasShadow="False">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry" Grid.Column="0" Placeholder="Crea una contraseña" 
                           IsPassword="True" PlaceholderColor="#9CA3AF" TextColor="#111827" 
                           FontSize="16" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    <ImageButton x:Name="BtnTogglePassword" Grid.Column="1" Source="eye_open.png" 
                                 WidthRequest="24" HeightRequest="24" Aspect="AspectFit" 
                                 BackgroundColor="Transparent" VerticalOptions="Center" 
                                 Clicked="OnTogglePasswordVisibility"/>
                </Grid>
            </Frame>
            <Label Text="Mínimo 8 caracteres" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Ubicación exacta *" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Entry x:Name="EntryUbicacion" Placeholder="Dirección de tu negocio" 
                   PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                   HeightRequest="50" Margin="0,0,0,5"/>
            <Label Text="Departamento ,Municipio ,barrio  " FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Horario de Atención *" 
                   TextColor="#1F2937" FontSize="17" FontAttributes="Bold" 
                   Margin="0,20,0,15"/>

            <Frame BackgroundColor="#FAFBFC" BorderColor="#E5E7EB" CornerRadius="14" Padding="18" HasShadow="False">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckLun" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Lunes" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchLun" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckLun}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Lun_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Lun_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchLun}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchLun}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Lun_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Lun_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckMar" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Martes" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchMar" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckMar}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Mar_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Mar_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchMar}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchMar}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Mar_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Mar_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckMie" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Miércoles" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchMie" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckMie}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Mie_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Mie_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchMie}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchMie}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Mie_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Mie_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckJue" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Jueves" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchJue" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckJue}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Jue_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Jue_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchJue}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchJue}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Jue_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Jue_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckVie" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Viernes" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchVie" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckVie}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Vie_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Vie_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchVie}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchVie}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Vie_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Vie_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckSab" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Sábado" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchSab" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckSab}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Sab_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Sab_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchSab}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchSab}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Sab_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Sab_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6"/>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <CheckBox x:Name="CheckDom" Grid.Column="0" Color="#3B82F6" VerticalOptions="Center" Scale="0.9"/>
                            <Label Text="Domingo" Grid.Column="1" FontSize="15" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                            <BoxView Grid.Column="2" Color="Transparent" HorizontalOptions="Fill"/>
                            <Frame Grid.Column="3" BackgroundColor="#4B5563" CornerRadius="16" Padding="4,3" HasShadow="False" VerticalOptions="Center">
                                <Switch x:Name="SwitchDom" IsToggled="False" OnColor="#3B82F6" ThumbColor="#FFFFFF" Scale="0.95" VerticalOptions="Center"/>
                            </Frame>
                            <Label Text="Pausa" Grid.Column="4" FontSize="12" TextColor="#6B7280" VerticalOptions="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="8" IsEnabled="{Binding Source={x:Reference CheckDom}, Path=IsChecked}">
                            <TimePicker x:Name="TP_Dom_Abre" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="08:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Dom_Cierra" Format="HH:mm" FontSize="14" BackgroundColor="#F9FAFB" TextColor="#1F2937" Time="18:00:00" HeightRequest="44" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" 
                                   IsVisible="{Binding Source={x:Reference SwitchDom}, Path=IsToggled}"
                                   IsEnabled="{Binding Source={x:Reference SwitchDom}, Path=IsToggled}">
                            <TimePicker x:Name="TP_Dom_PausaIni" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="12:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                            <Label Text="a" VerticalOptions="Center" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold"/>
                            <TimePicker x:Name="TP_Dom_PausaFin" Format="HH:mm" FontSize="13" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Time="13:00:00" HeightRequest="40" HorizontalOptions="FillAndExpand"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Label Text="Número RUC" TextColor="#111827" FontSize="14" FontAttributes="Bold"/>
            <Entry x:Name="EntryRuc" Placeholder="J0000000000" Keyboard="Text" 
                   PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="16" BackgroundColor="#F9FAFB" 
                   HeightRequest="50" Margin="0,0,0,5"/>
            <Label Text="Número de cédula jurídica del negocio" FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Label Text="Documentos de Verificación *" TextColor="#111827" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
            <Label Text="Diploma ,Título Profesional o carta de recomendación " FontSize="12" TextColor="#6B7280" Margin="0,-5,0,10"/>

            <Border Stroke="#E5E7EB" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="12">

                    <Button Text="+ Agregar Documento PDF" 
                            BackgroundColor="#EFF6FF" 
                            TextColor="#2563EB" 
                            FontAttributes="Bold" 
                            FontSize="14" 
                            CornerRadius="8" 
                            HeightRequest="44"
                            Clicked="OnSubirPdfClicked"/>

                    <CollectionView ItemsSource="{Binding ListaDocumentos}" 
                                    VerticalScrollBarVisibility="Never"
                                    IsVisible="{Binding HasDocumentos}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 8" 
                                        BackgroundColor="#F9FAFB" Padding="12">
                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">

                                        <Image Source="{FontImageSource FontFamily=MaterialIcons, Glyph='&#xE873;', Color=#EF4444, Size=24}" 
                                               HorizontalOptions="Center" VerticalOptions="Center"/>

                                        <Label Text="{Binding .}" 
                                               TextColor="#111827" 
                                               FontSize="13" 
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalOptions="Center" 
                                               HorizontalOptions="FillAndExpand"/>

                                        <Image Source="{FontImageSource FontFamily=MaterialIcons, Glyph='&#xE5CA;', Color=#10B981, Size=20}" 
                                               HorizontalOptions="End" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="No has agregado documentos aún." 
                           TextColor="#9CA3AF" 
                           FontSize="12" 
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasDocumentos, Converter={StaticResource InverseBoolConverter}}"/>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,20,0,0">
                <Button Text="Cancelar" BackgroundColor="White" TextColor="#111827" 
                        BorderColor="#D1D5DB" BorderWidth="1" CornerRadius="12" HeightRequest="50"
                        Clicked="OnCancelarClicked"/>
                <Button Grid.Column="1" Text="Crear cuenta" BackgroundColor="#2563EB" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="50"
                        Clicked="OnCrearCuentaClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>