<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="slotsi_citas.Pages.CancelacionesPage"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModel"
             Title="Cancelaciones"
             BackgroundColor="#F7F8FA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" BackgroundColor="#2563EB" Padding="16,14">
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0" Text="&#xE5C4;" FontFamily="MaterialIcons" FontSize="26"
                       TextColor="White" VerticalOptions="Center" Margin="0,0,10,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Cancelaciones" FontSize="19" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="12,0">
                    <Picker Title="Seleccionar período"
                            ItemsSource="{Binding Opciones}"
                            SelectedIndex="{Binding IndicePeriodo, Mode=TwoWay}"
                            TextColor="#111827" TitleColor="#9CA3AF" FontSize="14"
                            BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Border Grid.Row="1" BackgroundColor="White" Padding="16" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                 Color="#EF4444" VerticalOptions="Center" />
                        <Label Text="{Binding EtiquetaPerdida}" FontSize="12" TextColor="#4B5563" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding PorcentajePerdidaTexto}" FontSize="40"
                           FontAttributes="Bold" TextColor="#EF4444" />
                    <Label Text="{Binding DetalleTexto}" FontSize="12" TextColor="#374151" />
                    <Label Text="{Binding NoAsistioTexto}" FontSize="12" TextColor="#6B7280" />
                </VerticalStackLayout>
            </Border>

            <RefreshView Grid.Row="2" IsRefreshing="{Binding Cargando}"
                         Command="{Binding CargarCommand}">
                <CollectionView ItemsSource="{Binding Items}">
                    <CollectionView.EmptyView>
                        <Label Text="Sin cancelaciones en este período"
                               HorizontalOptions="Center" Margin="0,24" TextColor="#9CA3AF" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CitaCancelacionItem">
                            <Border BackgroundColor="White" Padding="14" Margin="0,0,0,8"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Fecha}" FontSize="12" TextColor="#374151" />
                                        <Label Text="{Binding Hora}" FontSize="11" TextColor="#9CA3AF" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Servicio}" FontAttributes="Bold"
                                               FontSize="14" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Cliente}" FontSize="12" TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2" Padding="8,3" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6" VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding EsNoAsistio}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FDE2E2" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding EsNoAsistio}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#FFEDD5" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding EstadoTexto}" FontSize="10" FontAttributes="Bold"
                                               TextColor="#B45309" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
