<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModels"
             xmlns:models="clr-namespace:slotsi_citas.Models"
             x:Class="slotsi_citas.Pages.SeleccionarCitaPage"
             x:DataType="vm:SeleccionarCitaViewModel"
             x:Name="PageRoot"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto">

        <!-- ROW 0: Header Azul -->
        <Grid Grid.Row="0" Padding="20,44,20,16" ColumnDefinitions="Auto, *" BackgroundColor="#2563EB">
            <ImageButton Grid.Column="0" Source="arrow_back.png" HeightRequest="24" WidthRequest="24" 
                         BackgroundColor="Transparent" Command="{Binding VolverCommand}" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="Seleccionar Cita" FontSize="20" FontAttributes="Bold" 
                   TextColor="#FFFFFF" Margin="12,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <!-- ROW 1: Contenido Scrollable -->
        <ScrollView Grid.Row="1" Padding="20,16">
            <VerticalStackLayout Spacing="20">

                <!-- Perfil del Cliente -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" 
                            BackgroundColor="#2563EB" StrokeThickness="0">
                        <Label Text="" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding ClienteNombre}" FontSize="16" FontAttributes="Bold" TextColor="#111827"/>
                        <Label Text="{Binding SucursalTexto}" FontSize="12" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Lista de Servicios Disponibles -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Servicios disponibles" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>

                    <CollectionView ItemsSource="{Binding ServiciosTarjetas}" ItemsLayout="HorizontalList" 
                                    HeightRequest="260" HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Servicios">
                                <Border WidthRequest="210" HeightRequest="250" BackgroundColor="#FFFFFF" 
                                        Stroke="#E5E7EB" StrokeThickness="2" StrokeShape="RoundRectangle 12" 
                                        Margin="0,0,12,0" Padding="0">

                                    <Grid RowDefinitions="100, *">
                                        <!-- Imagen del Servicio -->
                                        <Grid Grid.Row="0" BackgroundColor="#F3F4F6">
                                            <Image Source="{Binding Foto}" Aspect="AspectFill"/>
                                        </Grid>

                                        <!-- Detalles y Botón -->
                                        <VerticalStackLayout Grid.Row="1" Padding="10" Spacing="4">
                                            <Label Text="{Binding Nombre}" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                            <Label Text="{Binding Descripcion}" FontSize="10" TextColor="#6B7280"/>

                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding DuracionMinutos, StringFormat='{0} min'}" 
                                                       FontSize="11" TextColor="#6B7280"/>
                                                <Label Grid.Column="1" Text="{Binding Precio, StringFormat='C$ {0:N2}'}" 
                                                       FontSize="12" FontAttributes="Bold" TextColor="#2563EB"/>
                                            </Grid>

                                            <!-- Botón de Selección -->
                                            <Border Stroke="#2563EB" StrokeThickness="1" StrokeShape="RoundRectangle 8" 
                                                    Padding="0,6" Margin="0,6,0,0" BackgroundColor="Transparent">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleServicioCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="Agregar" TextColor="#2563EB" FontSize="11" 
                                                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Resumen de la Cita (Feedback Visual Principal) -->
                <VerticalStackLayout Spacing="12" Margin="0,10,0,20">
                    <Label Text="Resumen de tu cita" FontSize="15" FontAttributes="Bold" TextColor="#111827"/>

                    <!-- ✅ ENVUELTO EN BORDER PARA EVITAR ERROR XLS0413 -->
                    <Border Stroke="#E5E7EB" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 12" 
                            BackgroundColor="#F9FAFB" 
                            Padding="15">

                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="" FontSize="16" Margin="0,0,10,0"/>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Cliente" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                    <Label Text="{Binding ClienteNombre}" FontSize="11" TextColor="#6B7280"/>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout>
                                <Label Text="Fecha" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding FechaTextoResumen}" FontAttributes="Bold" TextColor="Black" />
                            </VerticalStackLayout>

                            <VerticalStackLayout>
                                <Label Text="Horario" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding HorarioTextoResumen}" FontAttributes="Bold" TextColor="Black" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="✂️" FontSize="16" Margin="0,0,10,0"/>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Servicio(s)" FontSize="13" FontAttributes="Bold" TextColor="#111827"/>
                                    <Label Text="{Binding ServicioNombreResumen}" FontSize="11" TextColor="#2563EB" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding ServicioPrecioResumen}" FontSize="13" TextColor="#111827" FontAttributes="Bold"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <Button Grid.Row="2" 
        Text="CONFIRMAR CITA - PRUEBA" 
        Clicked="BotonConfirmar_Clicked"
        BackgroundColor="#FF0000" 
        TextColor="White" 
        FontAttributes="Bold" 
        FontSize="18" 
        CornerRadius="12" 
        HeightRequest="60" 
        Margin="20,10,20,10"/>


        <Grid Grid.Row="3" ColumnDefinitions="*, *, *, *" BackgroundColor="#FFFFFF" HeightRequest="60" Padding="0,6">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="home.png" HeightRequest="22" WidthRequest="22"/>
                <Label Text="Inicio" FontSize="11" TextColor="#2563EB" FontAttributes="Bold"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="calendar.png" HeightRequest="22" WidthRequest="22"/>
                <Label Text="Citas" FontSize="11" TextColor="#6B7280"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="location.png" HeightRequest="22" WidthRequest="22"/>
                <Label Text="Sucursal" FontSize="11" TextColor="#6B7280"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="profile.png" HeightRequest="22" WidthRequest="22"/>
                <Label Text="Perfil" FontSize="11" TextColor="#6B7280"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>