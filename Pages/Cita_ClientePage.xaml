<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:slotsi_citas.ViewModels"
             xmlns:models="clr-namespace:slotsi_citas.Models"
             x:Class="slotsi_citas.Pages.Cita_ClientePage"
             x:DataType="vm:Cita_clienteViewModel"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False"
             Title="Citas de Clientes">

    <ContentPage.BindingContext>
        <vm:Cita_clienteViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Encabezado Azul Moderno -->
        <VerticalStackLayout Grid.Row="0" 
                           BackgroundColor="#2563EB" 
                           Padding="16,20,16,16" 
                           Spacing="12">

            <Label Text="Calendario de citas..." 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" 
                  VerticalOptions="Center">

                <ImageButton Grid.Column="0" 
                             Source="arrow_left.png" 
                             Command="{Binding SemanaAnteriorCommand}" 
                             HeightRequest="30" 
                             WidthRequest="30"
                             VerticalOptions="Center"/>

                <!-- DatePicker en lugar del Button de fecha -->
                <DatePicker Grid.Column="1"
                            Date="{Binding FechaSeleccionada, Mode=TwoWay}"
                            Format="d 'de' MMMM 'de' yyyy"
                            BackgroundColor="White"
                            TextColor="#2563EB"
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="210"
                            HeightRequest="40"/>

                <ImageButton Grid.Column="2" 
                             Source="arrow_right.png" 
                             Command="{Binding SemanaSiguienteCommand}" 
                             HeightRequest="30" 
                             WidthRequest="30" 
                             Margin="8,0,0,0"
                             VerticalOptions="Center"/>

                <Button Grid.Column="3" 
                        Text="Hoy" 
                        Command="{Binding CambiarAFechaDeHoyCommand}"
                        BackgroundColor="White" 
                        TextColor="#2563EB" 
                        CornerRadius="8" 
                        HeightRequest="38" 
                        Padding="12,0" 
                        FontSize="12" 
                        FontAttributes="Bold"
                        Margin="6,0,0,0"
                        VerticalOptions="Center"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Lista de Rangos Horarios -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding RangosHorarios}" 
                        Margin="16,12">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RangoHorario">
                    <Grid ColumnDefinitions="75,*" VerticalOptions="Center">

                        <Label Grid.Column="0"
                               Text="{Binding HoraDisplay}"
                               TextColor="#374151"
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Start"/>

                        <VerticalStackLayout Grid.Column="1">

                            <!-- Slot Disponible -->
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#F9FAFB" 
                                    Stroke="#E5E7EB" 
                                    StrokeThickness="1" 
                                    Padding="15,12"
                                    IsVisible="{Binding EsDisponible}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:Cita_clienteViewModel}}, Path=AgendarCitaClienteCommand}" 
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="Agendar cita" 
                                       TextColor="#2563EB" 
                                       FontAttributes="Bold" 
                                       FontSize="14" 
                                       VerticalOptions="Center"/>
                            </Border>

                            <!-- Slot Ocupado -->
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#FEF3C7" 
                                    StrokeThickness="0" 
                                    IsVisible="{Binding EsOcupado}" 
                                    Padding="0">
                                <Grid ColumnDefinitions="6,*">
                                    <BoxView Grid.Column="0" Color="#D97706" CornerRadius="10,0,0,10"/>
                                    <VerticalStackLayout Grid.Column="1" Padding="12,10" Spacing="2">
                                        <Label Text="Ocupado" FontAttributes="Bold" TextColor="#111827" FontSize="14"/>
                                        <Label Text="{Binding Cita.NombreCliente, StringFormat='Reservado {0}'}" FontSize="12" TextColor="#6B7280"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Slot No Disponible -->
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#F3F4F6" 
                                    StrokeThickness="0" 
                                    IsVisible="{Binding EsNoDisponible}" 
                                    Padding="0">
                                <Grid ColumnDefinitions="6,*">
                                    <BoxView Grid.Column="0" Color="#9CA3AF" CornerRadius="10,0,0,10"/>
                                    <VerticalStackLayout Grid.Column="1" Padding="12,10" Spacing="2">
                                        <Label Text="No disponible" FontAttributes="Bold" TextColor="#111827" FontSize="14"/>
                                        <Label Text="(1:00 - 2:00)" FontSize="12" TextColor="#6B7280"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Barra de Navegación Inferior -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*,*" 
              BackgroundColor="#FFFFFF" 
              HeightRequest="55" 
              Padding="0,4">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="home.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Inicio" FontSize="10" TextColor="#6B7280"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="calendar.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Citas" FontSize="10" TextColor="#2563EB" FontAttributes="Bold"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="location.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Sucursal" FontSize="10" TextColor="#6B7280"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="profile.png" HeightRequest="20" WidthRequest="20"/>
                <Label Text="Perfil" FontSize="10" TextColor="#6B7280"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>